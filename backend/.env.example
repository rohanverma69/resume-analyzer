# CareerAI Backend Environment Configuration
FLASK_ENV=development
PORT=5000

# Security (Must be at least 32 characters in production)
SECRET_KEY=change-me-to-a-secure-random-32-char-string-in-production
JWT_SECRET_KEY=change-me-to-a-secure-random-jwt-key-in-production
JWT_EXPIRY_HOURS=24

# Database
# For Local SQLite:
DATABASE_URL=sqlite:///careerai.db
# For Production MySQL:
# DATABASE_URL=mysql+pymysql://db_user:db_password@localhost:3306/careerai_db

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_STORAGE_URI=memory://
